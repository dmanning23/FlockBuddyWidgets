<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>FlockBuddyWidgets</PackageId>
    <Version>5.0.1</Version>
    <Title>FlockBuddyWidgets</Title>
    <Authors>dmanning23</Authors>
    <description>A set of screens and widgets that can be used with the FlockBuddy API</description>
    <PackageProjectUrl>https://github.com/dmanning23/FlockBuddyWidgets</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/dmanning23/FlockBuddyWidgets</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>monogame</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="MenuBuddy" Version="5.*"/>
    <PackageReference Include="FlockBuddy" Version="5.*"/>
  </ItemGroup>
</Project>